{
  "name": "ruum-ruum-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "types:supabase": "npx supabase gen types typescript --linked --schema public > lib/database.types.ts",
    "test": "npm run test:security && npm run test:db-contract && npm run test:performance && npm run test:companies-mobile && npm run test:ui-cleanup && npm run test:routes",
    "test:security": "node scripts/verify-admin-auth-and-roles.mjs",
    "test:db-contract": "node scripts/verify-db-contract-and-config.mjs",
    "test:performance": "node scripts/verify-admin-performance.mjs",
    "test:companies-mobile": "node scripts/verify-admin-companies-and-mobile-nav.mjs",
    "test:ui-cleanup": "node scripts/verify-admin-ui-cleanup.mjs",
    "test:routes": "node scripts/verify-conductor-route.mjs && node scripts/verify-admin-atomic-operations.mjs && node scripts/verify-sensitive-storage.mjs",
    "audit:high": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
